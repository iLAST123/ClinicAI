# ============================================================================
# ClinicAI — variáveis de ambiente (copie como .env.local e preencha)
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Pegue em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA expor no client. Usar apenas em API Routes server-side.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude API) -------------------------------------------------
# https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# --- Meta / Facebook --------------------------------------------------------
# https://developers.facebook.com → seu app → Settings → Basic
META_APP_ID=
META_APP_SECRET=
# Deve bater EXATAMENTE com a URL configurada em "Valid OAuth Redirect URIs"
META_REDIRECT_URI=https://seu-dominio.com/api/meta/callback

# --- Stripe -----------------------------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook secret: https://dashboard.stripe.com/webhooks → seu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Price IDs criados em https://dashboard.stripe.com/products
STRIPE_PRICE_SOLO=
STRIPE_PRICE_MANAGED=
STRIPE_PRICE_EXPANSION=

# --- Criptografia do token Meta --------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Proteção das API Routes chamadas pelo n8n -----------------------------
# String aleatória qualquer. Inclua como header `x-api-key` em todas as chamadas
# do n8n para /api/meta/sync, /api/meta/refresh-token, /api/decisions/generate.
N8N_API_KEY=

# --- Aplicação --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://seu-dominio.com
